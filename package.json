                    "group": "1_modification@3"
                },
                {
                    "command": "zit.openFiles",
                    "when": "zit.found && scmProvider == zit",
                    "group": "navigation"
                },
                {
                    "command": "zit.forget",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup == working",
                    "group": "2_modification"
                },
                {
                    "command": "zit.rename",
                    "when": "zit.found && scmProvider == zit && scmResourceState == MISSING",
                    "group": "2_modification"
                }
            ],
            "scm/resourceFolder/context": [
                {
                    "command": "zit.revert",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup == working",
                    "group": "1_modification"
                },
                {
                    "command": "zit.revert",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup == working",
                    "group": "inline"
                },
                {
                    "command": "zit.add",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup == untracked",
                    "group": "1_modification"
                },
                {
                    "command": "zit.clean",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup == untracked",
                    "group": "1_modification"
                },
                {
                    "command": "zit.ignore",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup == untracked",
                    "group": "1_modification@3"
                },
                {
                    "command": "zit.add",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup == untracked",
                    "group": "inline"
                },
                {
                    "command": "zit.openFiles",
                    "when": "zit.found && scmProvider == zit",
                    "group": "navigation"
                },
                {
                    "command": "zit.openChange",
                    "when": "zit.found && scmProvider == zit && scmResourceGroup != untracked",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "zit.openFileFromUri",
                    "group": "navigation",
                    "when": "zitOpenRepositoryCount && isInDiffEditor && resourceScheme != extension && scmProvider == zit"
                },
                {
                    "command": "zit.openChangeFromUri",
                    "group": "navigation",
                    "when": "zitOpenRepositoryCount && !isInDiffEditor && resourceScheme == file && scmProvider == zit"
                },
                {
                    "command": "zit.fileLog",
                    "when": "zitOpenRepositoryCount && !isInDiffEditor"
                }
            ]
        },
        "submenus": [
            {
                "id": "zit.merge",
                "label": "%submenu.merge%"
            },
            {
                "id": "zit.timeline",
                "label": "%submenu.timeline%"
            },
            {
                "id": "zit.tag",
                "label": "%submenu.tag%"
            },
            {
                "id": "zit.stash",
                "label": "%submenu.stash%"
            },
            {
                "id": "zit.remote",
                "label": "%submenu.remote%"
            },
            {
                "id": "zit.worktree",
                "label": "%submenu.worktree%"
            },
            {
                "id": "zit.commit",
                "label": "%submenu.commit%"
            }
        ],
        "configuration": {
            "title": "Zit",
            "properties": {
                "zit.autoSyncInterval": {
                    "type": "number",
                    "markdownDescription": "%config.autoSyncInterval%",
                    "default": 180,
                    "minimum": 0
                },
                "zit.autoRefresh": {
                    "type": "boolean",
                    "description": "%config.autoRefresh%",
                    "default": true
                },
                "zit.enableRenaming": {
                    "type": "boolean",
                    "description": "%config.enableRenaming%",
                    "default": true
                },
                "zit.ignoreMissingZitWarning": {
                    "type": "boolean",
                    "description": "Ignores the warning when Zit is missing",
                    "default": false
                },
                "zit.path": {
                    "type": "string",
                    "markdownDescription": "%config.path%",
                    "scope": "machine"
                },
                "zit.username": {
                    "type": "string",
                    "markdownDescription": "%config.username%"
                },
                "zit.defaultUsername": {
                    "type": "string",
                    "markdownDescription": "%config.defaultUsername%"
                },
                "zit.confirmGitExport": {
                    "type": "string",
                    "enum": [
                        "Automatically",
                        "Never",
                        "Ask"
                    ],
                    "default": "Ask",
                    "markdownDescription": "When repository was exported to git, ask to run `zit export` after every commit"
                },
                "zit.globalArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "scope": "window",
                    "markdownDescription": "Extra arguments added to each `zit` command (see `zit help -o`)"
                },
                "zit.commitArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "scope": "window",
                    "markdownDescription": "Extra arguments added to `zit commit` command (see `zit help commit`)"
                }
            }
        },
        "languages": [
            {
                "id": "pikchr",
                "extensions": [
                    ".pikchr"
                ],
                "icon": {
                    "dark": "pikchr/assets/pikchr.svg",
                    "light": "pikchr/assets/pikchr.svg"
                },
                "configuration": "pikchr/language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pikchr",
                "scopeName": "source.pikchr",
                "path": "./pikchr/pikchr.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.pikchr": "pikchr"
                }
            },
            {
                "scopeName": "markdown.pikchr.codeblock",
                "path": "./pikchr/codeblock.pikchr.tmLanguage.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.pikchr": "pikchr"
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run bundle -- --minify",
        "bundle": "node ./esbuild.config.js",
        "compile": "tsc -p ./",
        "package": "vsce package --allow-star-activation --allow-missing-repository",
        "deploy": "vsce publish",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "coverage": "node ./node_modules/c8/bin/c8.js --reporter lcov --exclude [] --check-coverage npm run test",
        "coverage-ci": "node ./node_modules/c8/bin/c8.js --reporter json-summary --exclude [] --check-coverage npm run test && node ./out/test/summaryAsMarkdown.js coverage/coverage-summary.json",
        "lint": "eslint ./src --ext .ts",
        "lint:fix": "eslint --fix ./src --ext .ts",
        "grammar-test": "vscode-tmgrammar-test ./pikchr/test/*.test.pikchr"
    },
    "dependencies": {
        "vscode-nls": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/eslint-formatter-sarif": "^3.1.0",
        "@types/mocha": "~10.0.10",
        "@types/node": "^24.0.0",
        "@types/sinon": "~22.0.0",
        "@types/vscode": "1.125.0",
        "@vscode/test-electron": "3.1.0",
        "@vscode/vsce": "3.9.2",
        "c8": "^12.0.0",
        "esbuild": "~0.28.2",
        "eslint": "^10.8.1",
        "eslint-plugin-prettier": "~5.5.6",
        "mocha": "~11.8.0",
        "prettier": "~3.9.6",
        "sinon": "~22.1.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vscode-tmgrammar-test": "^0.1.3"
    },
    "overrides": {
        "mocha": {
            "diff": "^9.0.0",
            "serialize-javascript": "^7.1.0"
        }
    }
}
